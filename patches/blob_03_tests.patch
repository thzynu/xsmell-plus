+import java.util.Collections;
+import java.util.List;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+/** Tests for RuleUtil.ignore, the method moved from CheckstyleViolationCheckMojo (case blob_03). */
+public class RuleUtilIgnoreTest
+{
+    private static final String LINE_LENGTH = "com.puppycrawl.tools.checkstyle.checks.sizes.LineLengthCheck";
+
+    private static final String FINAL_CLASS = "com.puppycrawl.tools.checkstyle.checks.design.FinalClassCheck";
+
+    @Test
+    public void emptyListIgnoresNothing()
+    {
+        assertFalse( RuleUtil.ignore( Collections.<RuleUtil.Matcher>emptyList(), LINE_LENGTH ) );
+    }
+
+    @Test
+    public void ruleNameMatchesItsCheckOnly()
+    {
+        List<RuleUtil.Matcher> ignores = RuleUtil.parseMatchers( new String[] { "LineLength" } );
+        assertTrue( RuleUtil.ignore( ignores, LINE_LENGTH ) );
+        assertFalse( RuleUtil.ignore( ignores, FINAL_CLASS ) );
+    }
+
+    @Test
+    public void anyMatchingMatcherIsEnough()
+    {
+        List<RuleUtil.Matcher> ignores = RuleUtil.parseMatchers( new String[] { "FinalClass", "LineLength" } );
+        assertTrue( RuleUtil.ignore( ignores, LINE_LENGTH ) );
+        assertTrue( RuleUtil.ignore( ignores, FINAL_CLASS ) );
+    }
+}
